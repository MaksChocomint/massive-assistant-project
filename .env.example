# Подключение к PostgreSQL (локально — порт из DB_PORT)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/assistant
# Порты на хосте для docker compose
DB_PORT=5432
APP_PORT=8000
# Сколько раз можно уточнять одну команду
MAX_CLARIFICATIONS=3
LOG_LEVEL=INFO
# Локальная русская модель для голосового ввода в Firefox (Docker задаёт путь сам)
SPEECH_MODEL_PATH=data/models/vosk-model-small-ru-0.22
